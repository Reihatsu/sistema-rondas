# ---------------------------------------------------------------------------
# Plantilla de variables de entorno del backend.
# Copiar a `.env` y completar los valores reales.
# ---------------------------------------------------------------------------

# --- Conexión MySQL (opcional) ---
# Si define cualquiera de estas variables se usa MySQL con PyMySQL.
# En Render, omita todas ellas para usar SQLite automáticamente.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=sistema_rondas_db

# --- SQLite (fallback / despliegues gratuitos) ---
# USE_SQLITE=true fuerza SQLite aunque existan variables MySQL.
# Sin variables MySQL se usa SQLite automáticamente.
USE_SQLITE=false
# Ruta del archivo (por defecto backend/sistema_rondas.db).
# SQLITE_DB_PATH=./sistema_rondas.db
# DATABASE_URL=sqlite:///./sistema_rondas.db

# --- Reglas de negocio de las rondas ---
# Minutos sin marcaciones tras los cuales una ronda en curso se cancela.
ROUND_INACTIVITY_TIMEOUT_MINUTES=20
# Radio por defecto de la geovalla de un checkpoint (metros).
DEFAULT_GEOFENCE_RADIUS_M=50
# Exige estar dentro del radio del checkpoint para registrar la marcación.
# false (por defecto): la marcación se acepta y la distancia se guarda como
# dato informativo. Poner true para restaurar la validación de proximidad.
ENFORCE_CHECKPOINT_GEOFENCE=false

# --- Seguridad / JWT ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (frontend Vite) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Comportamiento de arranque ---
INIT_DB_ON_STARTUP=true
AUTO_SEED_ADMIN=true
# Siembra empresa/usuarios/puntos demo cuando la base de datos está vacía.
AUTO_SEED_DEMO=true
FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_EMAIL=admin@sistema-rondas.local
FIRST_ADMIN_PASSWORD=Admin123!
