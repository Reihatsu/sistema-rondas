# URL base de la API FastAPI, incluyendo el prefijo /api/v1.
# Copie este archivo como `.env` y ajuste el valor según el entorno.
#
# Emulador Android: http://10.0.2.2:8000/api/v1
# Dispositivo físico: http://<IP-LAN-del-PC>:8000/api/v1
# Producción (Render): https://<servicio>.onrender.com/api/v1
EXPO_PUBLIC_API_URL=https://sistema-rondas-backend.onrender.com/api/v1