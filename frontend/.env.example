# URL base absoluta de la API (debe incluir /api/v1).
# Si no se define, se usa http://localhost:8000/api/v1 como respaldo.
# En Vercel: Project Settings -> Environment Variables -> VITE_API_BASE_URL
# con la URL pública del backend, por ejemplo:
#   VITE_API_BASE_URL=https://mi-api.onrender.com/api/v1
# Debe ser una URL absoluta (http:// o https://): Axios nunca debe resolver
# las peticiones contra el dominio del frontend.
VITE_API_BASE_URL=http://localhost:8000/api/v1
